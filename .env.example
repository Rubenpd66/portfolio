# Copy this file to .env.local and fill in the values. Never commit .env.local.

# Fine-grained GitHub token, read-only (Contents + Metadata).
# Server-only: never prefix it with NEXT_PUBLIC_.
GITHUB_TOKEN=

# GitHub username whose profile and repos are shown.
GITHUB_USERNAME=Rubenpd66

# Public URL of the site (used for canonical URLs, Open Graph, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
